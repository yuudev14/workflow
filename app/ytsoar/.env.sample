# For `make dev` (backend on your computer). Copy to .env.
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ytsoar
LOGGER_MODE=DEBUG
HTTP_ADDR=:8080

# worker
SANDBOX_ADDR=localhost:50052
MAX_PARALLEL_NODES=4
PLAYBOOK_CONCURRENCY=1
RUN_TIMEOUT_MINUTES=60
# time that running playbooks get to finish when the worker stops
WORKER_STOP_GRACE_SECONDS=20
NODE_TIMEOUT_SECONDS=300

# sandbox
SANDBOX_LISTEN_ADDR=:50052
CONNECTORS_DIR=../connectors
NODE_MEMORY_LIMIT_MB=256
PYTHON_MEMORY_LIMIT_MB=512

# auth
# In production the API refuses to start with the default JWT_SECRET.
APP_ENV=development
# Generate one: openssl rand -base64 48
JWT_SECRET=dev-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=168

# First admin. With an empty ADMIN_PASSWORD, no admin is created.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ytsoar.local
ADMIN_PASSWORD=admin123!

# No wildcard: browsers reject "*" on requests with credentials.
CORS_ORIGINS=http://localhost:9999,http://localhost:3000
# true when the site uses HTTPS
COOKIE_SECURE=false

# OIDC: where the callback returns the browser, and the public base for the IdP redirect.
# The invite and password reset links also start with FRONTEND_URL.
FRONTEND_URL=http://localhost:9999
AUTH_PUBLIC_URL=http://localhost:9999/auth-api

# Invite and password reset emails. With an empty SMTP_HOST, the email goes to the log.
# These values send to the dev Mailpit: read the emails at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ytsoar@localhost
