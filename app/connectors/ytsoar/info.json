    {
      "operation": "create_alert",
      "title": "Create alert",
      "description": "Creates an alert.",
      "annotation": "create_alert",
      "enabled": true,
      "parameters": [
        {
          "title": "Title",
          "name": "title",
          "description": "The alert title.",
          "required": true,
          "editable": true,
          "visible": true,
          "type": "text",
          "tooltip": "The alert title.",
          "placeholder": ""
        },
        {
          "title": "Severity",
          "name": "severity",
          "description": "critical, high, medium or low.",
          "required": true,
          "editable": true,
          "visible": true,
          "type": "text",
          "tooltip": "critical, high, medium or low.",
          "placeholder": "high"
        },
        {
          "title": "Source kind",
          "name": "source_kind",
          "description": "edr, identity, email, firewall or dlp.",
          "required": true,
          "editable": true,
          "visible": true,
          "type": "text",
          "tooltip": "edr, identity, email, firewall or dlp.",
          "placeholder": "email"
        },
        {
          "title": "Reporter",
          "name": "reporter",
          "description": "Who reported it.",
          "required": false,
          "editable": true,
          "visible": true,
          "type": "text",
          "tooltip": "Who reported it.",
          "placeholder": ""
        },
        {
          "title": "Assignee ID",
          "name": "assignee_id",
          "description": "A user id.",
          "required": false,
          "editable": true,
          "visible": true,
          "type": "text",
          "tooltip": "A user id.",
          "placeholder": ""
        },
        {
          "title": "Team ID",
          "name": "team_id",
          "description": "A team id.",
          "required": false,
          "editable": true,
          "visible": true,
          "type": "text",
          "tooltip": "A team id.",
          "placeholder": ""
        },
        {
          "title": "Tags",
          "name": "tags",
          "description": "Tags, separated by commas. Replaces the tags.",
          "required": false,
          "editable": true,
          "visible": true,
          "type": "text",
          "tooltip": "Tags, separated by commas. Replaces the tags.",
          "placeholder": "phishing, vip"
        },
        {
          "title": "Payload",
          "name": "payload",
          "description": "The raw event, as a JSON object.",
          "required": false,
          "editable": true,
          "visible": true,
          "type": "text",
          "tooltip": "The raw event, as a JSON object.",
          "placeholder": "{\"ip\": \"1.2.3.4\"}"
        }
      ],
      "output": [
        {
          "name": "id",
          "type": "string",
          "description": "Alert id"
        },
        {
          "name": "status",
          "type": "string",
          "description": "Alert status"
        }
      ]
    },
